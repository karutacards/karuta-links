{
  "name": "karuta-links",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "description": "Official Karuta dumps and short URLs at krta.cc.",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler d1 migrations apply karuta-links --local && wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply karuta-links --local",
    "db:migrate:remote": "wrangler d1 migrations apply karuta-links --remote"
  },
  "dependencies": {
    "hono": "4.13.7"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wrangler": "4.130.0"
  }
}
